; Generated configs are written to <theme>/.generated/switchboard/current.conf by that theme's labctl.sh.
; This file is a reference template only.

[global]
logfile = /state/docker-tcp-switchboard.log
loglevel = INFO

[profile:crypto]
innerport = 22
outerport = 40000
container = cyber-adventure-<theme>-crypto:latest
limit = 0
reuse = false

[profile:linux_box1_breadcrumbs]
innerport = 22
outerport = 40001
container = cyber-adventure-<theme>-linux1:latest
limit = 0
reuse = false

[profile:linux_box2_haystack]
innerport = 22
outerport = 40002
container = cyber-adventure-<theme>-linux2:latest
limit = 0
reuse = false

[profile:linux_box3_locked_pipeline]
innerport = 22
outerport = 40003
container = cyber-adventure-<theme>-linux3:latest
limit = 0
reuse = false

[profile:windows_box1_ghosts]
innerport = 22
outerport = 40004
container = cyber-adventure-<theme>-win1:latest
limit = 0
reuse = false

[profile:windows_box2_restricted_protocol]
innerport = 22
outerport = 40005
container = cyber-adventure-<theme>-win2:latest
limit = 0
reuse = false

[profile:windows_box3_persistence]
innerport = 22
outerport = 40006
container = cyber-adventure-<theme>-win3:latest
limit = 0
reuse = false

[profile:hack_box1_network_recon]
innerport = 22
outerport = 40007
container = cyber-adventure-<theme>-hack1:latest
limit = 0
reuse = false

[profile:hack_box2_cracking_suite]
innerport = 22
outerport = 40008
container = cyber-adventure-<theme>-hack2:latest
limit = 0
reuse = false

[profile:hack_box3_web_enum]
innerport = 22
outerport = 40009
container = cyber-adventure-<theme>-hack3:latest
limit = 0
reuse = false

[dockeroptions:hack_box1_network_recon]
cap_add = ["NET_RAW", "NET_ADMIN"]
network = <theme hack box1 network>

[dockeroptions:hack_box3_web_enum]
cap_add = ["NET_RAW", "NET_ADMIN"]
network = <theme hack box3 network>

[dockeroptions:windows_box3_persistence]
volumes = {"<absolute path to evidence dir>": {"bind": "<theme evidence mount point>", "mode": "ro"}}
